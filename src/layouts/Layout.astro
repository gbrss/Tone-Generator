---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Genera tonos puros de cualquier frecuencia directamente en tu navegador.' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>〰️</text></svg>" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #0f1218;
    --panel: #181d27;
    --panel-2: #212836;
    --border: #2d3548;
    --text: #e8ecf4;
    --muted: #9aa5bd;
    --accent: #4cc2ff;
    --accent-2: #2a8fd1;
    --warn-bg: #3a2a14;
    --warn-border: #7a5320;
    --warn-text: #ffd9a0;
    --radius: 12px;
  }
  @media (prefers-color-scheme: light) {
    :root {
      --bg: #f3f5f9;
      --panel: #ffffff;
      --panel-2: #eef1f7;
      --border: #d3d9e6;
      --text: #1b2230;
      --muted: #5b6579;
      --accent: #0b7fc7;
      --accent-2: #0a68a2;
      --warn-bg: #fff4e0;
      --warn-border: #e0b36a;
      --warn-text: #6b4410;
    }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.6;
  }
  a { color: var(--accent); }
  kbd {
    background: var(--panel-2);
    border: 1px solid var(--border);
    border-bottom-width: 2px;
    border-radius: 5px;
    padding: 0 6px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.85em;
    white-space: nowrap;
  }
</style>
